---
import { formatDate } from '../lib/site';

interface Props {
  href: string;
  title: string;
  summary: string;
  badge?: string; // 카테고리 또는 작업 기간
  date?: Date;
  tags?: string[];
  dataTags?: string; // 태그 필터용 ('태그1|태그2')
}

const { href, title, summary, badge, date, tags = [], dataTags } = Astro.props;
---

<a class="card note-card" href={href} data-tags={dataTags}>
  <div class="note-head">
    {badge ? <span class="chip chip-blue">{badge}</span> : <span></span>}
    {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
  </div>
  <h3>{title}</h3>
  <p>{summary}</p>
  {
    tags.length > 0 && (
      <div class="tag-row">
        {tags.map((t) => (
          <span class="chip">#{t}</span>
        ))}
      </div>
    )
  }
</a>
